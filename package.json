  "devDependencies": {
    "concurrently": "9.2.4",
    "electron-builder": "26.0.12",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.vayujit.os",
    "productName": "VAYUJIT OS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "VAYUJIT-OS-${version}-Setup.${ext}",
    "files": [
      "apps/desktop/dist/**/*",
      "dist/apps/web/browser/**/*",
      "version.json"
    ],
    "extraResources": [
      {
        "from": "apps/api",
        "to": "api",
        "filter": [
          "vayujit_api/**/*",
          "alembic/**/*",
          "alembic.ini",
          "pyproject.toml"
        ]
      },
      {
        "from": "scripts/start-packaged-api.ps1",
        "to": "scripts/start-packaged-api.ps1"
      },
      {
        "from": "scripts/backup-packaged-api.ps1",
        "to": "scripts/backup-packaged-api.ps1"
      },
      {
        "from": "scripts/resolve-pg-dump.ps1",
        "to": "scripts/resolve-pg-dump.ps1"
      },
      {
        "from": "scripts/initialize-packaged-config.ps1",
        "to": "scripts/initialize-packaged-config.ps1"
      },
      {
        "from": "scripts/install-packaged-api.ps1",
        "to": "scripts/install-packaged-api.ps1"
      },
      {
        "from": "docs/releases",
        "to": "docs/releases"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "VAYUJIT-OS-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VAYUJIT OS",
      "deleteAppDataOnUninstall": false
    }
  }
}
