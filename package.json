{
  "name": "vayujit-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x || 24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "install:all": "npm install && npm run api:install",
    "api:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-api.ps1",
    "dev": "concurrently -k -n API,WEB,DESKTOP \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "npm run start --workspace @vayujit/web",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-api.ps1",
    "dev:desktop": "npm run dev --workspace @vayujit/desktop",
    "test:desktop": "npm run test --workspace @vayujit/desktop",
    "test:desktop:smoke": "npm run build && npm run smoke --workspace @vayujit/desktop",
    "build": "npm run build --workspace @vayujit/shared && npm run build --workspace @vayujit/web && npm run build --workspace @vayujit/desktop",
    "lint": "npm run lint --workspaces --if-present && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-api.ps1",
    "test": "npm run test:all",
    "test:all": "npm run test:web && npm run test:desktop && npm run test:api && npm run test:api:integration",
    "test:web": "npm run test --workspace @vayujit/web -- --watch=false",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1",
    "test:api:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1",
    "test:api:migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-migrations.ps1",
    "test:workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_workflows_integration.py",
    "format": "prettier --write . && powershell -NoProfile -ExecutionPolicy Bypass -Command \"& apps/api/.venv/Scripts/black.exe apps/api\"",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-api.ps1",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:licenses": "node scripts/dependency-licenses.mjs",
    "security:check": "npm run security:audit:prod && npm run security:licenses",
    "system:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/system-doctor.ps1",
    "backup:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-create",
    "backup:list": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-list",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-verify",
    "backup:restore-plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-restore-plan",
    "maintenance:on": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-on",
    "maintenance:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-off",
    "maintenance:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-status",
    "maintenance:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-cleanup --dry-run",
    "sessions:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 sessions-cleanup",
    "migration:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 migration-status",
    "ai:provider:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 status",
    "ai:provider:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 validate",
    "ai:usage:summary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 usage-summary",
    "publishing:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 status",
    "publishing:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 validate",
    "publishing:destinations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 destinations",
    "publishing:executions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 executions",
    "publishing:reconcile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 reconcile",
    "publishing:shopify:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 status",
    "publishing:shopify:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 validate",
    "publishing:shopify:collections": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 collections",
    "publishing:shopify:publications": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 publications",
    "publishing:shopify:executions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 executions"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "prettier": "3.6.2"
  }
}
