{
  "name": "vayujit-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x || 24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "install:all": "npm install && npm run api:install",
    "api:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-api.ps1",
    "dev": "concurrently -k -n API,WEB,DESKTOP \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "npm run start --workspace @vayujit/web",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-api.ps1",
    "dev:desktop": "npm run dev --workspace @vayujit/desktop",
    "dev:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-publishing-worker.ps1",
    "worker:publishing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-publishing-worker.ps1",
    "publishing:schedules": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli schedules\"",
    "publishing:jobs": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli jobs\"",
    "publishing:jobs:due": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli due\"",
    "publishing:jobs:retry": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli jobs\"",
    "publishing:jobs:dead-letter": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli dead-letter\"",
    "publishing:workers": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli workers\"",
    "publishing:worker:once": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.publishing.worker once\"",
    "publishing:jobs:recover": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli recover --confirm\"",
    "publishing:schedules:materialize": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.scheduler_cli materialize --confirm\"",
    "campaigns:list": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli list\"",
    "campaigns:status": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli status\"",
    "campaigns:activities": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli activities\"",
    "campaigns:readiness": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli readiness\"",
    "campaigns:conflicts": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli conflicts\"",
    "campaigns:upcoming": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli upcoming\"",
    "campaigns:waits": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli waits\"",
    "campaigns:missed": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli missed\"",
    "campaigns:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli recovery\"",
    "campaigns:restore-waits": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli restore-waits --confirm\"",
    "campaigns:workflow-actions": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli workflow-actions\"",
    "campaigns:validate": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PYTHONPATH='apps/api'; & apps/api/.venv/Scripts/python.exe -m vayujit_api.campaigns_cli validate\"",
    "test:scheduler": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_scheduler_time.py",
    "test:workers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_scheduler_worker.py",
    "test:scheduler:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_scheduler_integration.py",
    "test:scheduler:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_scheduler_integration.py",
    "test:campaigns": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_campaigns.py",
    "test:campaigns:workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_campaign_completion.py",
    "test:campaigns:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_campaign_completion.py",
    "test:campaigns:calendar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_campaign_completion.py",
    "test:campaigns:wordpress": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_campaign_connectors_e2e.py",
    "test:campaigns:shopify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_campaign_connectors_e2e.py",
    "test:campaigns:selectors": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1 -TestPath tests/test_campaign_completion.py",
    "test:campaigns:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_campaigns_integration.py",
    "test:campaigns:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_campaign_connectors_e2e.py",
    "test:desktop": "npm run test --workspace @vayujit/desktop",
    "test:desktop:smoke": "npm run build && npm run smoke --workspace @vayujit/desktop",
    "build": "npm run build --workspace @vayujit/shared && npm run build --workspace @vayujit/web && npm run build --workspace @vayujit/desktop",
    "lint": "npm run lint --workspaces --if-present && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-api.ps1",
    "test": "npm run test:all",
    "test:all": "npm run test:web && npm run test:desktop && npm run test:api && npm run test:api:integration",
    "test:web": "npm run test --workspace @vayujit/web -- --watch=false",
    "test:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-unit.ps1",
    "test:api:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1",
    "test:api:migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-migrations.ps1",
    "test:workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-api-integration.ps1 -TestPath tests/test_workflows_integration.py",
    "format": "prettier --write . && powershell -NoProfile -ExecutionPolicy Bypass -Command \"& apps/api/.venv/Scripts/black.exe apps/api\"",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-api.ps1",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:licenses": "node scripts/dependency-licenses.mjs",
    "security:check": "npm run security:audit:prod && npm run security:licenses",
    "system:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/system-doctor.ps1",
    "backup:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-create",
    "backup:list": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-list",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-verify",
    "backup:restore-plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 backup-restore-plan",
    "maintenance:on": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-on",
    "maintenance:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-off",
    "maintenance:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-status",
    "maintenance:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 maintenance-cleanup --dry-run",
    "sessions:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 sessions-cleanup",
    "migration:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance.ps1 migration-status",
    "ai:provider:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 status",
    "ai:provider:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 validate",
    "ai:usage:summary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-diagnostics.ps1 usage-summary",
    "publishing:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 status",
    "publishing:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 validate",
    "publishing:destinations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 destinations",
    "publishing:executions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 executions",
    "publishing:reconcile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publishing-diagnostics.ps1 reconcile",
    "publishing:shopify:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 status",
    "publishing:shopify:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 validate",
    "publishing:shopify:collections": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 collections",
    "publishing:shopify:publications": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 publications",
    "publishing:shopify:executions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shopify-diagnostics.ps1 executions"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "prettier": "3.6.2"
  }
}
