{
  "name": "@vayujit/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && wait-on http://127.0.0.1:4200 && cross-env VAYUJIT_DESKTOP_DEV_URL=http://127.0.0.1:4200 electron .",
    "start": "electron .",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.13.3",
    "cross-env": "10.0.0",
    "electron": "43.2.0",
    "eslint": "9.31.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vitest": "3.2.4",
    "wait-on": "8.0.4"
  }
}
