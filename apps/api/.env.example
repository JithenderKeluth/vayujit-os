VAYUJIT_ENVIRONMENT=development
VAYUJIT_LOG_LEVEL=INFO
VAYUJIT_API_HOST=127.0.0.1
VAYUJIT_API_PORT=8000
VAYUJIT_WEB_ORIGIN=http://127.0.0.1:4200
VAYUJIT_ALLOWED_ORIGINS=http://127.0.0.1:4200,app://vayujit
VAYUJIT_ALLOW_MISSING_ORIGIN=false
VAYUJIT_DATABASE_URL=postgresql+psycopg://vayujit:vayujit_dev@127.0.0.1:5432/vayujit
# Optional absolute path to a trusted PostgreSQL client executable named pg_dump.exe.
# VAYUJIT_PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe
VAYUJIT_SESSION_LIFETIME_HOURS=24
VAYUJIT_SESSION_SECURE_COOKIE=false
VAYUJIT_REVOKED_SESSION_RETENTION_HOURS=24
VAYUJIT_INTELLIGENCE_EXTERNAL_PROVIDER_MODE=DISABLED
VAYUJIT_INTELLIGENCE_SEARCH_PROVIDER=deterministic
VAYUJIT_INTELLIGENCE_SEARCH_PROVIDER_BASE_URL=
# Never commit credentials; configure via local secret management.
VAYUJIT_INTELLIGENCE_SEARCH_PROVIDER_API_KEY=
VAYUJIT_INTELLIGENCE_EXTERNAL_APPROVED_DOMAINS=
VAYUJIT_INTELLIGENCE_EXTERNAL_BLOCKED_DOMAINS=
VAYUJIT_INTELLIGENCE_EXTERNAL_KILL_SWITCH=false
VAYUJIT_INTELLIGENCE_SEARCH_PROVIDER_KILL_SWITCH=false
VAYUJIT_INTELLIGENCE_EXTERNAL_MAX_RETRIES=2
VAYUJIT_INTELLIGENCE_EXTERNAL_RETRY_BACKOFF_SECONDS=0.25
