VAYUJIT_ENVIRONMENT=development
VAYUJIT_LOG_LEVEL=INFO
VAYUJIT_BACKUP_DIRECTORY=../../var/backups
VAYUJIT_BACKUP_RETENTION_COUNT=10
VAYUJIT_BACKUP_RETENTION_DAYS=30
VAYUJIT_EXPORT_RETENTION_HOURS=24
VAYUJIT_MAINTENANCE_MARKER=../../var/maintenance/enabled
VAYUJIT_RESTORE_ENABLED=false
VAYUJIT_BUILD_IDENTIFIER=development
VAYUJIT_GIT_COMMIT=unknown
VAYUJIT_BUILD_TIMESTAMP=unknown
VAYUJIT_NODE_VERSION=22-or-24
VAYUJIT_ELECTRON_VERSION=43.2.0
VAYUJIT_ANGULAR_BUILD_VERSION=22
# Generate once with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# VAYUJIT_CREDENTIAL_ENCRYPTION_KEY=
# OPENAI_API_KEY=
VAYUJIT_AI_REAL_PROVIDER_REQUIRED=false
VAYUJIT_AI_MODEL_CACHE_SECONDS=900
# WORDPRESS_SITE_URL=
# WORDPRESS_USERNAME=
# WORDPRESS_APPLICATION_PASSWORD=
VAYUJIT_WORDPRESS_REQUIRED=false
VAYUJIT_MEDIA_STORAGE_DIRECTORY=../../var/media
VAYUJIT_MEDIA_MAX_SIZE_BYTES=10485760
VAYUJIT_MEDIA_MAX_DIMENSION=10000
VAYUJIT_MEDIA_MIN_FREE_BYTES=104857600
VAYUJIT_WORDPRESS_TAXONOMY_CACHE_SECONDS=900
VAYUJIT_SHOPIFY_SHOP_DOMAIN=
VAYUJIT_SHOPIFY_ADMIN_API_ACCESS_TOKEN=
VAYUJIT_SHOPIFY_API_VERSION=2026-07
VAYUJIT_SHOPIFY_DISCOVERY_CACHE_SECONDS=900
VAYUJIT_PUBLISHING_WORKER_ENABLED=false
VAYUJIT_PUBLISHING_WORKER_CONCURRENCY=2
VAYUJIT_PUBLISHING_WORKER_POLL_SECONDS=2
VAYUJIT_PUBLISHING_JOB_LEASE_SECONDS=60
VAYUJIT_PUBLISHING_WORKER_HEARTBEAT_SECONDS=20
VAYUJIT_PUBLISHING_SCHEDULE_HORIZON_DAYS=30
VAYUJIT_PUBLISHING_SCHEDULE_MAX_PER_OWNER=1000
VAYUJIT_PUBLISHING_JOB_MAX_ATTEMPTS=5
# VAYUJIT_PUBLISHING_WORKER_ID=
VAYUJIT_API_HOST=127.0.0.1
VAYUJIT_API_PORT=8000
VAYUJIT_WEB_ORIGIN=http://127.0.0.1:4200
VAYUJIT_ALLOWED_ORIGINS=http://127.0.0.1:4200,app://vayujit
VAYUJIT_ALLOW_MISSING_ORIGIN=false
VAYUJIT_DATABASE_URL=postgresql+psycopg://vayujit:vayujit_dev@127.0.0.1:5432/vayujit
# Optional absolute path to a trusted PostgreSQL client executable named pg_dump.exe.
# VAYUJIT_PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe
VAYUJIT_TEST_DATABASE_URL=postgresql+psycopg://vayujit:vayujit_dev@127.0.0.1:5432/vayujit_test
VAYUJIT_SESSION_LIFETIME_HOURS=24
VAYUJIT_SESSION_SECURE_COOKIE=false
VAYUJIT_REVOKED_SESSION_RETENTION_HOURS=24
POSTGRES_DB=vayujit
POSTGRES_USER=vayujit
POSTGRES_PASSWORD=vayujit_dev

# Production-readiness foundation (local defaults keep fake providers and live mutations disabled)
VAYUJIT_DEBUG=false
VAYUJIT_SESSION_SECRET=
VAYUJIT_SESSION_SAME_SITE=lax
VAYUJIT_REQUIRE_HTTPS=false
VAYUJIT_TRUSTED_PROXY_IPS=
VAYUJIT_STORAGE_PROVIDER=filesystem
VAYUJIT_STORAGE_BUCKET=
VAYUJIT_CREDENTIAL_ENCRYPTION_KEY_ID=current
VAYUJIT_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
VAYUJIT_DATABASE_POOL_SIZE=5
VAYUJIT_DATABASE_MAX_OVERFLOW=10
VAYUJIT_DATABASE_POOL_TIMEOUT_SECONDS=30
VAYUJIT_DATABASE_POOL_RECYCLE_SECONDS=1800
VAYUJIT_DATABASE_STATEMENT_TIMEOUT_MS=30000
VAYUJIT_REQUEST_MAX_BODY_BYTES=10485760
VAYUJIT_REQUEST_RATE_LIMIT_PER_MINUTE=120
VAYUJIT_AUTH_RATE_LIMIT_PER_MINUTE=10
VAYUJIT_AI_RATE_LIMIT_PER_MINUTE=30
VAYUJIT_UPLOAD_RATE_LIMIT_PER_MINUTE=20
VAYUJIT_PROVIDER_REQUESTS_PER_MINUTE=60
VAYUJIT_PROVIDER_REQUESTS_PER_DAY=10000
VAYUJIT_PROVIDER_MAX_CONCURRENT_JOBS=4
VAYUJIT_PROVIDER_MAX_VIDEO_DURATION_SECONDS=300
VAYUJIT_PROVIDER_MAX_TOKENS=8192
VAYUJIT_METRICS_ENABLED=true
VAYUJIT_LIVE_AI_ENABLED=false
VAYUJIT_LIVE_SOCIAL_PUBLISHING_ENABLED=false
VAYUJIT_LIVE_MARKETPLACE_MUTATIONS_ENABLED=false
VAYUJIT_LIVE_ADS_MUTATIONS_ENABLED=false
VAYUJIT_EXTERNAL_MUTATIONS_EMERGENCY_STOP=false
VAYUJIT_PROVIDER_RUNTIME_MODE=fake
VAYUJIT_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
VAYUJIT_PROVIDER_READ_TIMEOUT_SECONDS=30
VAYUJIT_PROVIDER_TOTAL_TIMEOUT_SECONDS=45
VAYUJIT_PROVIDER_RETRY_MAX_ATTEMPTS=3
VAYUJIT_PROVIDER_RETRY_BACKOFF_SECONDS=1
VAYUJIT_ADS_LIVE_SPEND_ENABLED=false
VAYUJIT_ADS_OWNER_OPT_IN_REQUIRED=true
VAYUJIT_ADS_DAILY_SPEND_CAP=0
VAYUJIT_ADS_CAMPAIGN_SPEND_CAP=0
VAYUJIT_ADS_MARKETING_PLAN_SPEND_CAP=0
VAYUJIT_CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; base-uri 'self'