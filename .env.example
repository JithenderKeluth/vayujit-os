VAYUJIT_ENVIRONMENT=development
VAYUJIT_LOG_LEVEL=INFO
VAYUJIT_BACKUP_DIRECTORY=../../var/backups
VAYUJIT_BACKUP_RETENTION_COUNT=10
VAYUJIT_BACKUP_RETENTION_DAYS=30
VAYUJIT_EXPORT_RETENTION_HOURS=24
VAYUJIT_MAINTENANCE_MARKER=../../var/maintenance/enabled
VAYUJIT_RESTORE_ENABLED=false
VAYUJIT_BUILD_IDENTIFIER=development
VAYUJIT_GIT_COMMIT=unknown
VAYUJIT_BUILD_TIMESTAMP=unknown
VAYUJIT_NODE_VERSION=22-or-24
VAYUJIT_ELECTRON_VERSION=43.2.0
VAYUJIT_ANGULAR_BUILD_VERSION=22
# Generate once with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# VAYUJIT_CREDENTIAL_ENCRYPTION_KEY=
# OPENAI_API_KEY=
VAYUJIT_AI_REAL_PROVIDER_REQUIRED=false
VAYUJIT_AI_MODEL_CACHE_SECONDS=900
# WORDPRESS_SITE_URL=
# WORDPRESS_USERNAME=
# WORDPRESS_APPLICATION_PASSWORD=
VAYUJIT_WORDPRESS_REQUIRED=false
VAYUJIT_MEDIA_STORAGE_DIRECTORY=../../var/media
VAYUJIT_MEDIA_MAX_SIZE_BYTES=10485760
VAYUJIT_MEDIA_MAX_DIMENSION=10000
VAYUJIT_MEDIA_MIN_FREE_BYTES=104857600
VAYUJIT_WORDPRESS_TAXONOMY_CACHE_SECONDS=900
VAYUJIT_SHOPIFY_SHOP_DOMAIN=
VAYUJIT_SHOPIFY_ADMIN_API_ACCESS_TOKEN=
VAYUJIT_SHOPIFY_API_VERSION=2026-07
VAYUJIT_SHOPIFY_DISCOVERY_CACHE_SECONDS=900
VAYUJIT_API_HOST=127.0.0.1
VAYUJIT_API_PORT=8000
VAYUJIT_WEB_ORIGIN=http://127.0.0.1:4200
VAYUJIT_ALLOWED_ORIGINS=http://127.0.0.1:4200,app://vayujit
VAYUJIT_ALLOW_MISSING_ORIGIN=false
VAYUJIT_DATABASE_URL=postgresql+psycopg://vayujit:vayujit_dev@127.0.0.1:5432/vayujit
VAYUJIT_TEST_DATABASE_URL=postgresql+psycopg://vayujit:vayujit_dev@127.0.0.1:5432/vayujit_test
VAYUJIT_SESSION_LIFETIME_HOURS=24
VAYUJIT_SESSION_SECURE_COOKIE=false
VAYUJIT_REVOKED_SESSION_RETENTION_HOURS=24
POSTGRES_DB=vayujit
POSTGRES_USER=vayujit
POSTGRES_PASSWORD=vayujit_dev
