# VAYUJIT OS single-seller production template.
# Copy into a secret-managed deployment environment; never commit the filled file.
VAYUJIT_ENVIRONMENT=production
VAYUJIT_DEBUG=false
VAYUJIT_REQUIRE_HTTPS=true
VAYUJIT_SESSION_SECURE_COOKIE=true
VAYUJIT_SESSION_SAME_SITE=lax
VAYUJIT_PUBLIC_API_URL=https://api.example.invalid
VAYUJIT_PUBLIC_WEB_URL=https://app.example.invalid
VAYUJIT_ALLOWED_ORIGINS=https://app.example.invalid
# Compose-only values for the private PostgreSQL service and TLS proxy.
# Replace through the secret manager; these placeholders are not deployable.
POSTGRES_DB=<private-database-name>
POSTGRES_USER=<dedicated-database-role>
POSTGRES_PASSWORD=<secret-manager-database-password>
VAYUJIT_PUBLIC_WEB_DOMAIN=app.example.invalid
VAYUJIT_DATABASE_URL=postgresql+psycopg://<dedicated-role>:<secret>@<private-db-host>:5432/<database>
VAYUJIT_EXPECTED_MIGRATION_REVISION=20261203_0146
VAYUJIT_STORAGE_PROVIDER=s3
VAYUJIT_STORAGE_BUCKET=<private-media-bucket>
VAYUJIT_MEDIA_STORAGE_DIRECTORY=/var/lib/vayujit/media
VAYUJIT_BACKUP_DIRECTORY=/var/lib/vayujit/backups
VAYUJIT_BACKUP_RETENTION_COUNT=30
VAYUJIT_BACKUP_RETENTION_DAYS=90
VAYUJIT_SESSION_SECRET=<secret-manager-value-at-least-32-characters>
VAYUJIT_CREDENTIAL_ENCRYPTION_KEY=<secret-manager-value>
VAYUJIT_CREDENTIAL_ENCRYPTION_KEY_ID=current
VAYUJIT_EXTERNAL_MUTATIONS_EMERGENCY_STOP=true
VAYUJIT_LIVE_AI_ENABLED=false
VAYUJIT_LIVE_SOCIAL_PUBLISHING_ENABLED=false
VAYUJIT_LIVE_MARKETPLACE_MUTATIONS_ENABLED=false
VAYUJIT_LIVE_ADS_MUTATIONS_ENABLED=false
VAYUJIT_EMAIL_DELIVERY_ENABLED=false
VAYUJIT_LIVE_EMAIL_DELIVERY_ENABLED=false
VAYUJIT_PUBLISHING_WORKER_ENABLED=true
VAYUJIT_PUBLISHING_WORKER_CONCURRENCY=2
VAYUJIT_TRUSTED_PROXY_IPS=172.16.0.0/12
VAYUJIT_TLS_CERT_DIRECTORY=/etc/vayujit/tls

# Provider credentials are injected only when a separately approved provider
# certification exists. Keep the switches above disabled during first boot.
