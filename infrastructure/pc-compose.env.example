POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
VAYUJIT_DATABASE_NAME=vayujit_business
VAYUJIT_DATABASE_USER=vayujit_app
